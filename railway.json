{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["Dockerfile", "entrypoint.sh"]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": null, 
    "volumes": [
      {
        "id": "hermes_secure_vault",
        "mountPath": "/data"
      }
    ]
  }
}
